{
  "half_shape": {
    ".": { "commit": "。" },
    ",": { "commit": "，" },
    ";": { "commit": "；" },
    "\\": { "commit": "、" },
    "?": { "commit": "？" },
    "!": { "commit": "！" },
    ":": { "commit": "：" },
    "(": { "commit": "（" },
    ")": { "commit": "）" },
    "[": { "commit": "【" },
    "]": { "commit": "】" },
    "'": { "pair": ["'", "'"] },
    "\"": { "pair": ["“", "”"] },
    "-": { "alternatives": ["—", "–", "·"] },
    "<": { "alternatives": ["《", "〈", "«", "‹"] },
    ">": { "alternatives": ["》", "〉", "»", "›"] }
  },
  "full_shape": {
    "'": { "pair": ["'", "'"] },
    "\"": { "pair": ["“", "”"] }
  }
}
